# Server
PORT=5000
NODE_ENV=development
# Frontend origin(s) allowed by CORS + used for auth cookies. Comma-separate
# multiple origins (no spaces needed, they're trimmed) to allow your
# production Vercel domain, a custom domain, and local dev at once, e.g.:
# CLIENT_URL=https://classdesk.vercel.app,https://app.classdesk.com,http://localhost:5173
# Vercel preview deployment URLs (*.vercel.app) are always allowed automatically.
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://localhost:27017/classdesk

# Auth
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_DOMAIN=localhost

# Booking rules
CANCELLATION_CUTOFF_HOURS=6
ATTENDANCE_LOCK_HOURS=48

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_SUCCESS_URL=http://localhost:5173/invoices?status=success
STRIPE_CANCEL_URL=http://localhost:5173/invoices?status=cancelled

# Email (Nodemailer)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
EMAIL_FROM="ClassDesk <no-reply@classdesk.app>"

# Cron
INVOICE_CRON_SCHEDULE=0 6 1 * *
REMINDER_CRON_SCHEDULE=*/30 * * * *
