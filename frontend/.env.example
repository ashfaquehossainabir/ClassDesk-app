# Base URL of the deployed backend API, including the /api/v1 prefix.
# Leave unset for local dev — Vite's dev server proxies /api to localhost:5000
# (see vite.config.ts). Set this in Vercel's project settings for
# production/preview deployments, pointing at your Render backend, e.g.:
# VITE_API_URL=https://classdesk-api.onrender.com/api/v1
VITE_API_URL=
